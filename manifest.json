{
  "manifest_version": 3,
  "name": "Chrome Bookmarks Sorter",
  "version": "1.0",
  "description": "A powerful Chrome extension to sort and organize your bookmarks by name, URL, date added, or custom categories.",
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chrome Bookmarks Sorter"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}